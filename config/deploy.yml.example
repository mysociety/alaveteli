# Example Kamal configuration for Alaveteli installations
service: alaveteli
image: edithatogo/alaveteli

servers:
  web:
    - 192.168.1.100
  job:
    hosts:
      - 192.168.1.101
    cmd: bundle exec sidekiq

registry:
  server: ghcr.io
  username: edithatogo
  password:
    - KAMAL_REGISTRY_PASSWORD

env:
  clear:
    DB_HOST: 192.168.1.102
    REDIS_URL: redis://192.168.1.103:6379/0
  secret:
    - RAILS_MASTER_KEY
    - FYI_BOT_TOKEN
    - TURNSTILE_SECRET_KEY
