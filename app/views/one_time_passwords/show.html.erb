<% @title = _('{{user_name}} - Two Factor Authentication',
              :user_name => h(@user.name)) %>

<h1 class="one-time-password-page-title"><%= @title %></h1>

<% if @user.totp? %>
  <div class="one-time-password">
    <% if flash[:just_upgraded_from_hotp] %>
      <div class="one-time-password__callout one-time-password__callout--warning">
        <h2><%= _('Discard your previous one time passcode') %></h2>

        <p>
          <%= _('Your account previously used a one time passcode that you ' \
                'were asked to save in a password manager or print out. ' \
                'That passcode no longer works.') %>
        </p>

        <p>
          <strong>
            <%= _('Delete the passcode saved in your password manager and ' \
                  'shred any printed copy.') %>
          </strong>
          <%= _("Don't delete the new authenticator app entry you just " \
                "set up, that's what you will use from now on.") %>
        </p>
      </div>
    <% end %>

    <% if flash[:backup_codes] %>
      <%= render 'backup_codes', codes: flash[:backup_codes] %>
    <% end %>

    <p>
      <%= _('Two factor authentication is active on your account. ' \
            "You'll need to enter the code from your authenticator app " \
            'for sensitive actions like sign-ins and password changes.') %>
    </p>

    <ul class="one-time-password-actions not-for-print">
      <li class="one-time-password-actions__action-item action-item">
        <%= link_to one_time_password_backup_codes_path,
                    :class => 'action-item__action' do %>
          <%= _('Manage backup codes') %>
        <% end %>
      </li>
      <li class="one-time-password-actions__action-item action-item">
        <%= link_to one_time_password_path, :method => :delete,
                                            :class => 'action-item__action' do %>
          <%= _('Disable two factor authentication') %>
        <% end %>
      </li>
    </ul>
  </div>
<% elsif @user.hotp? %>
  <div class="one-time-password">
    <div class="one-time-password__callout one-time-password__callout--info">
      <h2><%= _('Upgrade to authenticator app') %></h2>

      <p>
        <%= _('You are using an older form of two factor authentication ' \
              'based on a printable one time passcode. Switch to an ' \
              'authenticator app for stronger protection — your printable ' \
              'passcode will be replaced by codes generated on your phone ' \
              'or computer.') %>
      </p>

      <%= link_to _('Upgrade to authenticator app'),
                  new_one_time_password_path,
                  class: 'button' %>
    </div>

    <h2 class="one-time-password__title">
      <%= _('Your current one time passcode:') %>
    </h2>

    <div class="one-time-password__otp-code">
      <%= @user.otp_code %>
    </div>

    <div class="one-time-password__otp-info">
      <p>
        <%= _('<strong>Keep this passcode safe.</strong> You will need it to ' \
              'confirm your account when changing your password. You can add ' \
              'it to a password manager or print it and store it in a safe ' \
              'place.') %>
      </p>

      <p>
        <strong><%= _('Do not share this passcode.') %></strong>
      </p>
    </div>

    <ul class="one-time-password-actions not-for-print">
      <li class="one-time-password-actions__action-item action-item">
        <%= link_to _('Print your one time passcode'), '',
              :onclick => 'window.print();return false;',
              :class => 'action-item__action' %>
      </li>

      <li class="one-time-password-actions__action-item action-item">
        <% confirmation_msg = _('Are you sure? If you regenerate your one ' \
                                'time passcode you will need to update your ' \
                                'password manager or re-print it.') %>
        <%= link_to one_time_password_path, :method => :put,
                                            :data => {
                                                :confirm => confirmation_msg },
                                            :class => 'action-item__action' do %>
          <%= _('Regenerate one time passcode') %>
        <% end %>
      </li>
      <li class="one-time-password-actions__action-item action-item">
        <% confirmation_msg = _('Are you sure you want to disable two factor ' \
                                'authentication? Your account will be less ' \
                                'secure.') %>
        <%= link_to one_time_password_path, :method => :delete,
                                            :data => { :confirm => confirmation_msg },
                                            :class => 'action-item__action' do %>
          <%= _('Disable two factor authentication') %>
        <% end %>
      </li>
    </ul>
  </div>
<% else %>
  <ul class="one-time-password-actions not-for-print">
    <li class="one-time-password-actions__action-item action-item">
      <%= link_to _('Enable two factor authentication'),
                  new_one_time_password_path,
                  class: 'action-item__action' %>
    </li>
  </ul>
<% end %>

<%= render :partial => 'help_guide' %>
