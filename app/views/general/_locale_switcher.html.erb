<div id="user_locale_switcher" class="locale-list">
  <% if switchable_locales.any? %>
    <p class="locale-list-trigger">
      <strong class="current-locale" tabindex="0"><%= locale_name(current_locale) %></strong>
    </p>

    <%= form_tag locale_path, method: :put, class: 'available-languages-form' do %>
      <%= hidden_field_tag :return_to, request.fullpath, id: nil %>

      <ul class="available-languages">
        <% switchable_locales.each do |locale| %>
          <li class="available-languages__item">
            <%= button_tag locale_name(locale),
                           name: :locale,
                           value: locale,
                           class: 'available-languages__option' %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
  </div>
