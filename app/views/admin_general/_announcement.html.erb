<div class="row">
  <div class="span12">
    <div class="alert <%= announcement_admin_alert_class(announcement) %> alert-dismissible <%= announcement_style_class(announcement) %>">
      <%= link_to announcement_path(announcement), method: :delete, remote: true, class: 'close', data: { dismiss: 'alert' }, aria: { label: 'Close' } do %>
        <span aria-hidden="true">&times;</span>
      <% end %>
      <% if announcement.title.present? %><strong><%= announcement.title %> - </strong><% end %>
      <%= announcement_as_html(announcement) %>
    </div>
  </div>
</div>
