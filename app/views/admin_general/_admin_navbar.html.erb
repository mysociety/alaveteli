<div class="admin">
  <div id="admin-navbar" class="navbar navbar-fixed-top navbar-inverse">
    <div class="navbar-inner">
      <div class="container">
        <%= link_to 'Alaveteli', frontpage_path, class: 'brand' %>

        <div class="nav-collapse">
          <ul class="nav">
            <% if session[:user_circumstance] == 'login_as' %>
              <%= render partial: 'admin_general/admin_navbar/login_as' %>
            <% else %>
              <%= render partial: 'admin_general/admin_navbar/summary' %>
              <%= render partial: 'admin_general/admin_navbar/requests' %>
              <%= render partial: 'admin_general/admin_navbar/authorities' %>
              <%= render partial: 'admin_general/admin_navbar/users' %>
              <%= render partial: 'admin_general/admin_navbar/tools' %>
            <% end %>

            <li><%= link_to 'Log out', signout_path %></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
