<ul class="breadcrumb">
  <li>User: <%= both_links(@admin_user) %></li>
</ul>

<div class="row">
  <div class="span12 help-block">
    <p>
      Censor rules that apply to requests made by this user: those attached to
      the user, to their requests or to the authorities they have made requests
      to, and global rules.
    </p>

    <% if feature_enabled?(:redaction_tracking) %>
      <p>
        Redactions are only recorded as content is rendered, so records that
        haven't been viewed since redaction tracking was enabled won't be
        listed.
      </p>
    <% end %>

    <p>
      Making rules permanent locks the attachments they have redacted and
      erases the underlying raw emails, so that we no longer hold the original
      content. The selected rules are then erased. Only rules attached to this
      user or their requests can be made permanent.
    </p>
  </div>
</div>

<div class="row">
  <% if @censor_rules.any? %>
    <%= form_tag make_permanent_admin_user_censor_rules_path(@admin_user),
                 class: 'span12' do %>
      <table class="table table-condensed table-hover censor-rule-list">
        <tr>
          <th></th>
          <th>Id</th>
          <th>Applies to</th>
          <th>Text</th>
          <th>Replacement</th>
          <th>Regexp?</th>
          <th>Last edit comment</th>
          <% if feature_enabled?(:redaction_tracking) %>
            <th>Records redacted</th>
          <% end %>
          <th>Actions</th>
        </tr>

        <% @censor_rules.each do |censor_rule| %>
          <% redactions = @redactions.fetch(censor_rule.id, []) %>

          <tr id="<%= dom_id(censor_rule) %>">
            <td>
              <% if censor_rule.erasable? %>
                <%= check_box_tag 'censor_rule_ids[]', censor_rule.id, false,
                                  id: "censor_rule_ids_#{censor_rule.id}" %>
              <% end %>
            </td>
            <td class="id">
              <%= censor_rule.id %>
            </td>
            <td class="applies-to"><%= censor_rule_applies_to(censor_rule) %></td>
            <td class="text"><%= censor_rule.text %></td>
            <td class="replacement"><%= censor_rule.replacement %></td>
            <td class="regexp"><%= censor_rule.regexp? %></td>
            <td class="last_edit_comment"><%= censor_rule.last_edit_comment %></td>

            <% if feature_enabled?(:redaction_tracking) %>
              <td>
                <% if redactions.empty? %>
                  <span class="badge">0</span>
                <% else %>
                  <span class="badge badge-warning"><%= redactions.size %></span>
                <% end %>
              </td>
            <% end %>

            <td>
              <% if censor_rule.erased? %>
                <span class="label">Erased</span>
              <% else %>
                <%= link_to 'Edit', edit_admin_censor_rule_path(censor_rule) %>
              <% end %>
            </td>
          </tr>

          <% redactions.each do |redaction| %>
            <tr class="muted redaction">
              <td></td>
              <td></td>
              <td colspan="2">
                &#8627; <%= both_links(redaction.redactable) %>
              </td>
              <td><tt><%= redaction.redactable_type %></tt></td>
              <td colspan="4"><tt><%= redaction.redacted_attribute %></tt></td>
            </tr>
          <% end %>
        <% end %>
      </table>

      <%= submit_tag 'Make these rules permanent',
                     class: 'btn btn-danger',
                     data: {
                       confirm: 'This will lock attachments and erase raw ' \
                                'emails, which cannot be undone. Continue?'
                     } %>
    <% end %>
  <% else %>
    <p class="span12">None.</p>
  <% end %>
</div>
