<div class="row">
  <div class="span12">
    <div class="page-header">
      <h1><%= @title = 'Citations' %></h1>
    </div>
  </div>
</div>

<div class="row">
  <div class="span12">
    <p class="lead">
      Citations link requests to places they’re referenced elsewhere.
    </p>
  </div>
</div>


<%= form_tag({}, method: :get, class: 'form form-search') do %>
  <div class="input-append">
    <%= text_field_tag 'query', params[:query], size: 30, class: 'input-large search-query' %>
    <%= submit_tag 'Search', class: 'btn' %>
  </div>

  <span class="help-inline">(substring search, source_url)</span>

  <%= render partial: 'concerns/admin/searchable/search_engine',
             locals: {
               legacy_label: 'substring search in titles only',
               new_label: 'whole word search in titles; please report ' \
                          'poor search results!'
             } %>
<% end %>

<div class="row">
  <div class="span12">
    <%= render partial: 'concerns/admin/sortable/sort_options' %>
  </div>
</div>

<%= render partial: 'admin/citations/list',
           locals: { citations: @citations } %>

<%= will_paginate(@citations) %>

<%= render 'concerns/admin/searchable/search_stats' %>
