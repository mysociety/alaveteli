<% @title = _('Choose your password') %>

<div id="choose_password" class="change_password">
  <% form_params = { as: :confirm_user,
                     url: request.path,
                     method: :post } %>

  <%= form_for @confirm_user, form_params do |f| %>
    <%= foi_error_messages_for :confirm_user %>

    <div class="form_note">
      <h1><%= @title %></h1>
      <p><%= _('Choose a password to finish creating your account.') %></p>
    </div>

    <p>
      <%= f.label :password, _('Password:'), class: 'form_label' %>
      <%= f.password_field :password, size: 15, autocomplete: 'new-password' %>
    </p>

    <div class="form_item_note">
      <%= _('12 characters minimum. 72 characters maximum.') %>
    </div>

    <p>
      <%= f.label :password_confirmation, _('Confirm password:'),
                  class: 'form_label' %>
      <%= f.password_field :password_confirmation,
                           size: 15,
                           autocomplete: 'new-password' %>
    </p>

    <div class="form_button">
      <%= f.submit _('Confirm your account') %>
    </div>
  <% end %>
</div>
