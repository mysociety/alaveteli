<div class="accordion-group">
  <% request =
    case request_search_result.searchable_type
    when "InfoRequest"
      request_search_result.searchable
    when "IncomingMessage"
      request_search_result.searchable.info_request
    when "OutgoingMessage"
      request_search_result.searchable.info_request
    when "FoiAttachment"
      request_search_result.searchable.incoming_message.info_request
    end %>
  <div class="accordion-heading accordion-toggle row">
    <span class="item-title span6">
<% if request.nil? %>
  REQUEST NIL (this is for debugging)
<% end %>
<% if !request.nil? %>
        <%= both_links(request) %>
      <% if request.embargo %>
        <%= content_tag(:span, "embargoed", class: "label") %>
      <% end %>
    </span>
    <span class="item-metadata span6">
      <%= both_links(request.user) %>
      <%= arrow_right %>
      <%= both_links(request.public_body) %>
      ,
      <% if defined?(sort_order) && sort_order =~ /created_at/ %>
        <%= admin_date(request.created_at, ago: false) %>
      <% else %>
        <%= admin_date(request.updated_at, ago_only: true) %>
      <% end %>
    </span>
  </div>

  <div
    id="result_detail_<%=request_search_result.sd_id%>"
    class="item-detail row search_sub_result"
  >
    <%= render partial:
      "request_search_result_#{request_search_result.searchable_type.downcase}",
    locals: {
      hit: request_search_result.searchable,
    } %>
  </div>

  <div
    id="request_<%=request_search_result.sd_id%>"
    class="item-detail accordion-body collapse row"
  >
    <% request.for_admin_column do |name, value| %>
      <div>
        <span class="span6">
          <%= name.humanize %>
        </span>
        <span class="span6">
          <%= admin_value(value) %>
        </span>
      </div>
    <% end %>
  </div>
<% end %>
</div>
