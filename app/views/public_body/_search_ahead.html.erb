<% if !@request_results.nil? %>
  <% if @request_results.results.size > 0 %>
    <p><%= n_('{{count}} matching authority',
              '{{count}} matching authorities',
              @request_results.results.size,
              :count => @request_results.results.size) %></p>
  <% else %>
    <p><%= _('No results found.') %></p>
  <% end %>
  <div class="authority_search_ahead_results_container">
    <div id="authority_search_ahead_results">
      <% for result in @request_results.results %>
        <%= render :partial => 'public_body/body_listing_single',
          :locals => { :public_body => result[:model],
                       :request_link => true } %>
      <% end %>
    </div>
    <%= will_paginate WillPaginate::Collection.new(@page, @per_page, @request_results.matches_estimated), :params => {:controller=>"request", :action => "select_authority", :pro => @in_pro_area ? "1" : "0"} %>
  </div>
<% end %>
