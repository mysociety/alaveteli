<% if @results[:results].empty? %>
  <p> <%= _('No requests of this sort yet.')%></p>
<% else %>
  <h2 class="foi_results">
    <%= _('About {{count}} FOI requests found',
          :count => @results[:matches_estimated]) %></h2>
  <div class="results_block">
    <% @results[:results].each do |info_request| %>
      <%= render :partial => 'request/request_listing_single', :locals => { :info_request => info_request } %>
    <% end %>
  </div>
<% end %>
<%= will_paginate WillPaginate::Collection.new(@page, @per_page, @results[:show_no_more_than]) %>
