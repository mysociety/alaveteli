<% if @results.total_entries.zero? %>
  <p> <%= _('No requests of this sort yet.')%></p>
<% else %>
  <h2 class="foi_results">
    <%= _('About {{count}} FOI requests found',
          :count => @results.total_entries) %></h2>
  <div class="results_block">
    <%= render partial: 'request/request_listing_single',
               collection: @results, as: :info_request %>
  </div>
<% end %>
<%= will_paginate WillPaginate::Collection.new(
      @page, @per_page, [@results.total_entries, @max_results].min
    ) %>
