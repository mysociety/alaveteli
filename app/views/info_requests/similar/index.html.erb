<%- @title = _("Requests similar to '{{request_title}}'",
               :request_title => @info_request.title) %>

<h1>
  <%= _("Requests similar to '{{request_title}}'",
        :request_title => request_link(@info_request)) %>
</h1>

<% if @results.empty? %>
    <p><%= _('No similar requests found.')%></p>
<% else %>
  <% @results.each do |info_request| %>
    <%= render partial: 'request/request_listing_single',
               locals: { info_request: info_request } %>
  <% end %>
<% end %>
