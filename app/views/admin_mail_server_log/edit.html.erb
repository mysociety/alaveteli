<h1>Edit Mail server log</h1>

<%= form_with(
  model: @mail_server_log,
  url: admin_mail_server_log_path(@mail_server_log),
  method: :put,
  class: "form form-inline"
) do |f| %>

  <div class="field">
    <%= f.text_area :line, class: "form-control span12", rows: 5 %>
  </div>

  <div class="form-actions">
    <%= f.submit "Update log line", class: "btn btn-success" %>
  </div>
<% end %>
